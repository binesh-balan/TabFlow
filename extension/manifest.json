{
  "manifest_version": 3,
  "name": "TabFlow",
  "version": "1.0.0",
  "description": "Rotate through your tabs on a timer, full screen, in the order you choose. No install-time permission warnings.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TabFlow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-rotation": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Start or stop rotating tabs in the current window"
    }
  }
}
